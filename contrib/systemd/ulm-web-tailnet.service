# ulm web を tailnet 直アクセスで常時起動する systemd ユーザーユニット（Linux）。
#
# 設置（ユーザー単位・root 不要。リポジトリのルートで実行）:
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/ulm-web-tailnet.service ~/.config/systemd/user/
#   # __NODE__/__ULM_JS__ を実パスへ置換（node で安全に。sed だと & や # を含むパスで壊れる）。
#   # __NODE__ は node の実体の絶対パス（process.execPath）。asdf/volta/fnm の shim はダメ
#   # （systemd はシェル初期化が無く shim が版を解決できずクラッシュループする）。
#   （リポジトリ/node のパスに空白が含まれる環境は systemd 側では非対応。--port/ULM_HOME はユニットを直接編集）
#   node -e 'const fs=require("fs"),f=process.argv[1];fs.writeFileSync(f,fs.readFileSync(f,"utf8").split("__NODE__").join(process.execPath).split("__ULM_JS__").join(process.cwd()+"/bin/ulm.js").split("__REPO__").join(process.cwd()))' ~/.config/systemd/user/ulm-web-tailnet.service
#   loginctl enable-linger "$USER"   # 常時起動には必須（headless/再起動後の自動起動。無いとログイン中のみ動く）
#   systemctl --user daemon-reload
#   systemctl --user enable --now ulm-web-tailnet
#
# 確認: systemctl --user status ulm-web-tailnet ／ journalctl --user -u ulm-web-tailnet -f
#
# macOS と違い Linux の tailscaled は unix socket 経由なので、--tailnet が headless でも動く。
# 検出が不安定な環境では下記 ExecStart をコメントの固定指定版に差し替える。

# 注意: これは user unit なので、system 側の tailscaled.service への After= は効かない
# （user manager は system unit を順序付けできない）。Tailscale 接続前の初回起動は
# detectTailnet が失敗するが、Restart=always/RestartSec=10 で接続後に自動回復するのが本来の仕組み。
[Unit]
Description=ulm web (tailnet direct access)

[Service]
Type=simple
# WorkingDirectory はリポジトリルートに固定（/api/ref/add の allowRoots=cwd を launchd と揃える。
# 未設定だと user manager 既定の ~ や / になり、受理パス根が広がる）。
WorkingDirectory=__REPO__
# ポート/ULM_HOME を変えるなら下の --port と Environment=ULM_HOME= を直接編集する
# （ULM_PORT/ULM_HOME 環境変数は launchd の install.sh のみが解釈する。systemd 側は固定）。
ExecStart=__NODE__ __ULM_JS__ web --tailnet --port 8765
# 固定指定版（検出を使わない・最も堅牢）:
# ExecStart=__NODE__ __ULM_JS__ web --host <100.x IP> --allow-host <node>.<tailnet>.ts.net --no-token --port 8765
Environment=ULM_HOME=%h/.claude/user-memory
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
