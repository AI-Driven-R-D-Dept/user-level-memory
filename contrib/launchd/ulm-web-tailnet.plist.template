<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ulm web を tailnet 直アクセスで常時起動する LaunchAgent テンプレート。
  プレースホルダ（__FOO__）は contrib/launchd/install.sh が導入時に実値へ置換する。

  重要: サービスでは tailscale CLI を呼ばない（--tailnet を使わない）。
  macOS App Store 版 Tailscale CLI は GUI セッション依存で、launchd 等の非対話環境では
  "The Tailscale GUI failed to start" を返し JSON を出さないため。代わりにこのノードの
  安定値（100.x IP + MagicDNS 名）を install 時に検出して固定指定する。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__ULM_JS__</string>
    <string>web</string>
    <string>--host</string>
    <string>__TAILNET_IP__</string>
    <string>--allow-host</string>
    <string>__MAGICDNS__</string>
    <string>--no-token</string>
    <string>--port</string>
    <string>__PORT__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ULM_HOME</key>
    <string>__ULM_HOME__</string>
  </dict>

  <!-- ログイン時に起動し、落ちたら自動再起動。Tailscale 接続前は 100.x が無く bind 失敗するが
       ThrottleInterval=10 で 10 秒おきに再試行し、接続後に bind 成功する。 -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
