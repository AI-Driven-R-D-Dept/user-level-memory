{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -r \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\" ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -r \"${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt.sh\" ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -r \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-capture.sh\" ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-capture.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 150,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-}\" ] && [ -r \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.sh\" ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
